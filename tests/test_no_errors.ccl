1           # ( -- 1)
2           # (1 -- 1 2)
3           # (1 2 -- 1 2 3)
print       # (1 2 3 -- 1 2)
pop         # (1 2 -- 1)
print       # (1 -- )
2 2 mul     # (2 2 -- 4)
print       # (4 -- )
1 2         # ( -- 1 2)
jmp end     # (1 2 -- 1 2)
halt
end:
print       # (1 2 -- 1)
pop         # (1 -- )
